rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isPlatformAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/platformAdmins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/platformAdmins/$(request.auth.uid)).data.status == 'ACTIVE';
    }

    function isTenantAdminRole(role) {
      return role in ['OWNER'];
    }

    function isTenantAdmin(tenantId) {
      return isSignedIn() &&
        !isPlatformAdmin() &&
        exists(/databases/$(database)/documents/tenantMemberships/$(request.auth.uid + '_' + tenantId)) &&
        get(/databases/$(database)/documents/tenantMemberships/$(request.auth.uid + '_' + tenantId)).data.uid == request.auth.uid &&
        get(/databases/$(database)/documents/tenantMemberships/$(request.auth.uid + '_' + tenantId)).data.tenantId == tenantId &&
        get(/databases/$(database)/documents/tenantMemberships/$(request.auth.uid + '_' + tenantId)).data.status == 'ACTIVE' &&
        isTenantAdminRole(get(/databases/$(database)/documents/tenantMemberships/$(request.auth.uid + '_' + tenantId)).data.role);
    }

    function isAdmin() {
      return isPlatformAdmin();
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isActiveTenantMember(tenantId) {
      return isTenantAdmin(tenantId);
    }

    function isIsoDate(value) {
      return value is string && value.matches('^\\d{4}-\\d{2}-\\d{2}$');
    }

    function isTime(value) {
      return value is string && value.matches('^\\d{2}:\\d{2}$');
    }

    function isOptionalString(field) {
      return !(field in request.resource.data) || request.resource.data[field] is string;
    }

    function isOptionalBool(field) {
      return !(field in request.resource.data) || request.resource.data[field] is bool;
    }

    function isOptionalIntOrNull(field) {
      return !(field in request.resource.data) ||
        request.resource.data[field] == null ||
        request.resource.data[field] is int;
    }

    function onlyChanged(allowedFields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowedFields);
    }

    function employeeFields() {
      return [
        'fullName', 'role', 'color', 'afm', 'phone', 'email', 'hireDate', 'isActive', 'schedulerV3',
        'scheduleRole', 'roleType', 'fixedDayOff', 'fixedDaysOff', 'defaultShiftPreference',
        'participatesInRotation', 'participatesInSundayRotation', 'weeklyFixedShiftSideRotation',
        'fixedStartTime', 'fixedEndTime', 'staticStartTime', 'staticEndTime',
        'extraMode', 'activeFrom', 'activeTo', 'canCoverLeaves', 'canWorkMorning',
        'canWorkIntermediate', 'canWorkAfternoon', 'canWorkSunday', 'createdAt', 'updatedAt'
      ];
    }

    function publicEmployeeFields() {
      return [
        'fullName', 'role', 'color', 'isActive',
        'scheduleRole', 'roleType', 'fixedDayOff', 'fixedDaysOff', 'defaultShiftPreference',
        'participatesInRotation', 'participatesInSundayRotation', 'weeklyFixedShiftSideRotation',
        'fixedStartTime', 'fixedEndTime', 'staticStartTime', 'staticEndTime',
        'extraMode', 'activeFrom', 'activeTo', 'canCoverLeaves', 'canWorkMorning',
        'canWorkIntermediate', 'canWorkAfternoon', 'canWorkSunday', 'createdAt', 'updatedAt'
      ];
    }

    function privateEmployeeFields() {
      return [
        'afm', 'phone', 'email', 'address', 'hireDate', 'personalNotes',
        'internalComments', 'payrollId', 'createdAt', 'updatedAt'
      ];
    }

    function validEmployee() {
      return request.resource.data.keys().hasAll(['fullName']) &&
        request.resource.data.keys().hasOnly(employeeFields()) &&
        request.resource.data.fullName is string &&
        request.resource.data.fullName.size() > 0 &&
        (!('schedulerV3' in request.resource.data) || validEmployeeProfileV3(request.resource.data.schedulerV3)) &&
        isOptionalString('role') &&
        isOptionalString('color') &&
        isOptionalString('afm') &&
        isOptionalString('phone') &&
        isOptionalString('email') &&
        isOptionalString('hireDate') &&
        isOptionalString('scheduleRole') &&
        isOptionalString('roleType') &&
        isOptionalString('defaultShiftPreference') &&
        isOptionalString('extraMode') &&
        isOptionalString('activeFrom') &&
        isOptionalString('activeTo') &&
        isOptionalBool('isActive') &&
        isOptionalBool('participatesInRotation') &&
        isOptionalBool('participatesInSundayRotation') &&
        isOptionalBool('weeklyFixedShiftSideRotation') &&
        isOptionalBool('canCoverLeaves') &&
        isOptionalBool('canWorkMorning') &&
        isOptionalBool('canWorkIntermediate') &&
        isOptionalBool('canWorkAfternoon') &&
        isOptionalBool('canWorkSunday') &&
        isOptionalIntOrNull('fixedDayOff');
    }

    function validEmployeeProfileV3(p) {
      return p is map && p.keys().hasOnly(['workMode','fixedDayOff','targetWeeklyHours','standardShiftTemplateId','rotateStandardShiftWeekly','rotationAlternateShiftTemplateId','rotationAnchorWeekStart']) &&
        p.workMode in ['NORMAL','SUBSTITUTE_ONLY'] && (p.fixedDayOff == null || (p.fixedDayOff is int && p.fixedDayOff >= 0 && p.fixedDayOff <= 6)) &&
        (p.targetWeeklyHours == null || (p.targetWeeklyHours is number && p.targetWeeklyHours >= 0 && p.targetWeeklyHours <= 168)) && p.rotateStandardShiftWeekly is bool;
    }
    function validDraftShiftV3() {
      let d = request.resource.data;
      return d.keys().hasOnly(['id','date','employeeId','employeeName','shiftTemplateId','startTime','endTime','durationHours','crossMidnight','source','isManualOverride','schedulerSchemaVersion','draftId','type']) &&
        d.schedulerSchemaVersion == 3 && d.draftId is string && d.draftId.matches('^[a-zA-Z0-9_-]{1,100}$') && d.employeeId is string && isIsoDate(d.date) && isTime(d.startTime) && isTime(d.endTime) &&
        d.durationHours is number && d.durationHours > 0 && d.durationHours <= 24 && d.source in ['AUTO','MANUAL'] && d.type == 'work';
    }

    function validPublicEmployee() {
      return request.resource.data.keys().hasAll(['fullName']) &&
        request.resource.data.keys().hasOnly(publicEmployeeFields()) &&
        request.resource.data.fullName is string &&
        request.resource.data.fullName.size() > 0 &&
        isOptionalString('role') &&
        isOptionalString('color') &&
        isOptionalString('scheduleRole') &&
        isOptionalString('roleType') &&
        isOptionalString('defaultShiftPreference') &&
        isOptionalString('extraMode') &&
        isOptionalString('activeFrom') &&
        isOptionalString('activeTo') &&
        isOptionalBool('isActive') &&
        isOptionalBool('participatesInRotation') &&
        isOptionalBool('participatesInSundayRotation') &&
        isOptionalBool('weeklyFixedShiftSideRotation') &&
        isOptionalBool('canCoverLeaves') &&
        isOptionalBool('canWorkMorning') &&
        isOptionalBool('canWorkIntermediate') &&
        isOptionalBool('canWorkAfternoon') &&
        isOptionalBool('canWorkSunday') &&
        isOptionalIntOrNull('fixedDayOff');
    }

    function validPrivateEmployee() {
      return request.resource.data.keys().hasOnly(privateEmployeeFields()) &&
        isOptionalString('afm') &&
        isOptionalString('phone') &&
        isOptionalString('email') &&
        isOptionalString('address') &&
        isOptionalString('hireDate') &&
        isOptionalString('personalNotes') &&
        isOptionalString('internalComments') &&
        isOptionalString('payrollId');
    }

    function shiftFields() {
      return [
        'employeeId', 'date', 'startTime', 'endTime', 'type', 'label', 'shiftType',
        'customLabel', 'notes', 'duration', 'isManualOverride', 'isHoliday',
        'isSpecialDay', 'specialDayLabel', 'generationRunId', 'shiftTemplateId',
        'demandSlotId', 'crossMidnight', 'durationHours', 'createdAt', 'updatedAt'
      ];
    }

    function validShift() {
      return request.resource.data.keys().hasAll(['employeeId', 'date', 'startTime', 'endTime']) &&
        request.resource.data.keys().hasOnly(shiftFields()) &&
        request.resource.data.employeeId is string &&
        isIsoDate(request.resource.data.date) &&
        isTime(request.resource.data.startTime) &&
        isTime(request.resource.data.endTime) &&
        isOptionalString('type') &&
        isOptionalString('label') &&
        isOptionalString('shiftType') &&
        isOptionalString('customLabel') &&
        isOptionalString('notes') &&
        isOptionalString('generationRunId') &&
        isOptionalString('shiftTemplateId') &&
        isOptionalString('demandSlotId') &&
        isOptionalBool('crossMidnight') &&
        (!('durationHours' in request.resource.data) || request.resource.data.durationHours is number) &&
        isOptionalBool('isManualOverride') &&
        isOptionalBool('isHoliday') &&
        isOptionalBool('isSpecialDay') &&
        isOptionalString('specialDayLabel');
    }

    function absenceFields() {
      return [
        'employeeId', 'employeeName', 'type', 'startDate', 'endDate', 'scope', 'replacementMode',
        'manualReplacementEmployeeId', 'note', 'status', 'createdBy', 'updatedBy',
        'createdAt', 'updatedAt'
      ];
    }

    function validAbsence() {
      return request.resource.data.keys().hasAll([
        'employeeId', 'type', 'startDate', 'endDate', 'replacementMode'
      ]) &&
        request.resource.data.keys().hasOnly(absenceFields()) &&
        request.resource.data.employeeId is string &&
        request.resource.data.employeeId.size() > 0 &&
        request.resource.data.type in ['LEAVE', 'SICK', 'OTHER'] &&
        isIsoDate(request.resource.data.startDate) &&
        isIsoDate(request.resource.data.endDate) &&
        request.resource.data.startDate <= request.resource.data.endDate &&
        (!('scope' in request.resource.data) || request.resource.data.scope in [
          'FULL_DAY', 'MORNING_ONLY', 'INTERMEDIATE_ONLY', 'AFTERNOON_ONLY', 'SUNDAY_12H_ONLY'
        ]) &&
        request.resource.data.replacementMode in ['AUTO', 'MANUAL', 'NO_REPLACEMENT'] &&
        (
          request.resource.data.replacementMode != 'MANUAL' ||
          (
            'manualReplacementEmployeeId' in request.resource.data &&
            request.resource.data.manualReplacementEmployeeId is string &&
            request.resource.data.manualReplacementEmployeeId.size() > 0
          )
        ) &&
        (!('manualReplacementEmployeeId' in request.resource.data) || request.resource.data.manualReplacementEmployeeId is string) &&
        (!('status' in request.resource.data) || request.resource.data.status in ['ACTIVE', 'CANCELLED']) &&
        isOptionalString('employeeName') &&
        isOptionalString('note') &&
        isOptionalString('createdBy') &&
        isOptionalString('updatedBy');
    }

    function publicAbsenceFields() {
      return ['id', 'employeeName', 'typeLabel', 'startDate', 'endDate', 'totalDays', 'status'];
    }

    function validPublicAbsence() {
      return request.resource.data.keys().hasAll([
        'id', 'employeeName', 'typeLabel', 'startDate', 'endDate', 'totalDays', 'status'
      ]) &&
        request.resource.data.keys().hasOnly(publicAbsenceFields()) &&
        request.resource.data.id is string &&
        request.resource.data.employeeName is string &&
        request.resource.data.typeLabel is string &&
        isIsoDate(request.resource.data.startDate) &&
        isIsoDate(request.resource.data.endDate) &&
        request.resource.data.startDate <= request.resource.data.endDate &&
        request.resource.data.totalDays is int &&
        request.resource.data.totalDays >= 1 &&
        request.resource.data.status in ['ACTIVE', 'CANCELLED'];
    }

    function validPublicAbsencePatch() {
      return request.resource.data.keys().hasOnly(publicAbsenceFields()) &&
        (!('id' in request.resource.data) || request.resource.data.id is string) &&
        (!('employeeName' in request.resource.data) || request.resource.data.employeeName is string) &&
        (!('typeLabel' in request.resource.data) || request.resource.data.typeLabel is string) &&
        (!('startDate' in request.resource.data) || isIsoDate(request.resource.data.startDate)) &&
        (!('endDate' in request.resource.data) || isIsoDate(request.resource.data.endDate)) &&
        (!('totalDays' in request.resource.data) || (request.resource.data.totalDays is int && request.resource.data.totalDays >= 1)) &&
        (!('status' in request.resource.data) || request.resource.data.status in ['ACTIVE', 'CANCELLED']);
    }

    function settingsFields() {
      return ['generatorRules', 'schedulerConfigV2', 'schedulerConfigV3', 'schedulerSchemaVersion', 'specialDaysByDate', 'createdAt', 'updatedAt'];
    }

    function validSchedulerSettings() {
      return request.resource.data.keys().hasOnly(settingsFields()) &&
        (!('schedulerSchemaVersion' in request.resource.data) || request.resource.data.schedulerSchemaVersion in [2,3]) &&
        (!('schedulerConfigV3' in request.resource.data) || (request.resource.data.schedulerConfigV3 is map && request.resource.data.schedulerConfigV3.schemaVersion == 3)) &&
        (!( 'generatorRules' in request.resource.data) || request.resource.data.generatorRules is map) &&
        (!( 'schedulerConfigV2' in request.resource.data) || request.resource.data.schedulerConfigV2 is map) &&
        (!( 'specialDaysByDate' in request.resource.data) || request.resource.data.specialDaysByDate is map);
    }

    function validWeekLock() {
      return request.resource.data.keys().hasAll(['weekStart', 'weekDays']) &&
        request.resource.data.keys().hasOnly(['weekStart', 'weekDays', 'finalizedBy', 'finalizedAt', 'createdAt', 'updatedAt']) &&
        isIsoDate(request.resource.data.weekStart) &&
        request.resource.data.weekDays is list &&
        isOptionalString('finalizedBy');
    }

    function validWeekHistory() {
      return request.resource.data.keys().hasAll(['weekId', 'weekStart', 'weekEnd', 'shifts']) &&
        request.resource.data.keys().hasOnly([
          'weekId', 'weekStart', 'weekEnd', 'source', 'shifts', 'shiftCount',
          'createdBy', 'savedBy', 'savedAt', 'metadata', 'createdAt', 'updatedAt'
        ]) &&
        request.resource.data.weekId is string &&
        isIsoDate(request.resource.data.weekStart) &&
        isIsoDate(request.resource.data.weekEnd) &&
        request.resource.data.shifts is list &&
        isOptionalString('source') &&
        isOptionalString('createdBy') &&
        isOptionalString('savedBy');
    }

    function validPublishedSchedule(scheduleId) {
      return request.resource.data.keys().hasAll(['weekStart', 'weekEnd', 'shiftCount', 'shifts']) &&
        request.resource.data.keys().hasOnly([
          'weekStart', 'weekEnd', 'shiftCount', 'shifts', 'publishedAt', 'updatedAt'
        ]) &&
        request.resource.data.weekStart == scheduleId &&
        isIsoDate(request.resource.data.weekStart) &&
        isIsoDate(request.resource.data.weekEnd) &&
        request.resource.data.shiftCount is number &&
        request.resource.data.shifts is list;
    }

    function validTenantPublicSchedule(tenantId, scheduleId) {
      return request.resource.data.keys().hasAll(['tenantId', 'weekStart', 'weekEnd', 'shiftCount', 'shifts']) &&
        request.resource.data.keys().hasOnly([
          'tenantId', 'weekStart', 'weekEnd', 'shiftCount', 'shifts', 'publishedAt', 'updatedAt'
        ]) &&
        request.resource.data.tenantId == tenantId &&
        request.resource.data.weekStart == scheduleId &&
        isIsoDate(request.resource.data.weekStart) &&
        isIsoDate(request.resource.data.weekEnd) &&
        request.resource.data.shiftCount is number &&
        request.resource.data.shiftCount >= 0 &&
        request.resource.data.shifts is list;
    }

    function validTenantPublicMonth(tenantId, yearMonth) {
      return request.resource.data.keys().hasAll(['tenantId', 'yearMonth', 'monthStart', 'monthEnd', 'shiftCount', 'shifts']) &&
        request.resource.data.keys().hasOnly([
          'tenantId', 'yearMonth', 'monthStart', 'monthEnd', 'monthDays',
          'weekStarts', 'shiftCount', 'shifts', 'publishedAt', 'updatedAt'
        ]) &&
        request.resource.data.tenantId == tenantId &&
        request.resource.data.yearMonth == yearMonth &&
        request.resource.data.yearMonth.matches('^\\d{4}-\\d{2}$') &&
        isIsoDate(request.resource.data.monthStart) &&
        isIsoDate(request.resource.data.monthEnd) &&
        request.resource.data.shiftCount is number &&
        request.resource.data.shiftCount >= 0 &&
        request.resource.data.shifts is list &&
        (!('monthDays' in request.resource.data) || request.resource.data.monthDays is list) &&
        (!('weekStarts' in request.resource.data) || request.resource.data.weekStarts is list);
    }

    function validTenantPublicEmployee(tenantId) {
      return request.resource.data.keys().hasAll(['tenantId', 'fullName']) &&
        request.resource.data.keys().hasOnly(['tenantId', 'fullName', 'role', 'color', 'isActive', 'updatedAt']) &&
        request.resource.data.tenantId == tenantId &&
        request.resource.data.fullName is string &&
        request.resource.data.fullName.size() > 0 &&
        isOptionalString('role') &&
        isOptionalString('color') &&
        (!('isActive' in request.resource.data) || request.resource.data.isActive is bool);
    }

    function validTenantPublicAnnouncement(tenantId) {
      return request.resource.data.keys().hasAll(['tenantId', 'title', 'body']) &&
        request.resource.data.keys().hasOnly(['tenantId', 'title', 'body', 'createdAt', 'updatedAt']) &&
        request.resource.data.tenantId == tenantId &&
        request.resource.data.title is string &&
        request.resource.data.title.size() > 0 &&
        request.resource.data.body is string &&
        request.resource.data.body.size() > 0;
    }

    function validMonthlyScheduleExport(exportId) {
      return request.resource.data.keys().hasAll([
          'tenantId', 'yearMonth', 'fileName', 'storagePath', 'createdBy', 'shiftCount', 'status', 'createdAt', 'updatedAt'
        ]) &&
        request.resource.data.keys().hasOnly([
          'tenantId', 'yearMonth', 'fileName', 'storagePath', 'createdBy', 'shiftCount', 'status', 'createdAt', 'updatedAt'
        ]) &&
        exportId == request.resource.data.tenantId + '_' + request.resource.data.yearMonth &&
        request.resource.data.tenantId is string &&
        request.resource.data.tenantId.matches('^[a-z0-9-]{1,60}$') &&
        request.resource.data.yearMonth is string &&
        request.resource.data.yearMonth.matches('^\\d{4}-\\d{2}$') &&
        request.resource.data.fileName == 'program_month_' + request.resource.data.yearMonth + '.pdf' &&
        request.resource.data.storagePath ==
          'tenants/' + request.resource.data.tenantId + '/monthly_schedule_pdfs/' +
          request.resource.data.yearMonth + '/' + request.resource.data.fileName &&
        request.resource.data.createdBy is string &&
        request.resource.data.createdBy.size() <= 160 &&
        request.resource.data.shiftCount is number &&
        request.resource.data.shiftCount >= 0 &&
        request.resource.data.status == 'READY';
    }

    function validTemplate() {
      return request.resource.data.keys().hasOnly([
        'name', 'label', 'weekStart', 'shifts', 'createdBy', 'createdAt', 'updatedAt',
        'startTime', 'endTime', 'type', 'shiftType', 'customLabel', 'notes', 'color'
      ]);
    }

    function validAnnouncement() {
      return request.resource.data.keys().hasOnly(['title', 'body', 'message', 'createdBy', 'authorEmail', 'createdAt', 'updatedAt']) &&
        (('title' in request.resource.data && request.resource.data.title is string) ||
          ('message' in request.resource.data && request.resource.data.message is string) ||
          ('body' in request.resource.data && request.resource.data.body is string));
    }

    function validAuditLog() {
      return request.resource.data.keys().hasAll(['action', 'actor', 'target', 'createdAt']) &&
        request.resource.data.keys().hasOnly([
          'action', 'actor', 'target', 'before', 'after', 'metadata',
          'generationRunId', 'createdAt'
        ]) &&
        request.resource.data.action is string &&
        request.resource.data.action.size() > 0 &&
        request.resource.data.actor is map &&
        request.resource.data.target is map &&
        (!('metadata' in request.resource.data) || request.resource.data.metadata is map) &&
        isOptionalString('generationRunId');
    }

    function validAttendanceHistory() {
      return request.resource.data.keys().hasAll(['employeeId', 'date']) &&
        request.resource.data.keys().hasOnly([
          'employeeId', 'employeeName', 'date', 'weekStart', 'startTime', 'endTime',
          'type', 'label', 'shiftType', 'hours', 'notes', 'finalizedAt',
          'createdAt', 'updatedAt'
        ]) &&
        request.resource.data.employeeId is string &&
        isIsoDate(request.resource.data.date);
    }

    function validUserProfile(uid) {
      return request.resource.data.keys().hasOnly([
        'uid', 'email', 'displayName', 'status', 'createdAt', 'updatedAt'
      ]) &&
        (!('uid' in request.resource.data) || request.resource.data.uid == uid) &&
        isOptionalString('email') &&
        isOptionalString('displayName') &&
        (!('status' in request.resource.data) || request.resource.data.status in ['ACTIVE', 'DISABLED']);
    }

    function validTenant() {
      return request.resource.data.keys().hasAll(['slug']) &&
        request.resource.data.keys().hasOnly([
          'slug', 'domain', 'displayName', 'name', 'status', 'createdAt', 'updatedAt'
        ]) &&
        request.resource.data.slug is string &&
        request.resource.data.slug.matches('^[a-z0-9][a-z0-9-]{1,62}[a-z0-9]$') &&
        isOptionalString('domain') &&
        isOptionalString('displayName') &&
        isOptionalString('name') &&
        (!('status' in request.resource.data) || request.resource.data.status in ['ACTIVE', 'DISABLED']);
    }

    function validTenantMembership() {
      return request.resource.data.keys().hasAll(['uid', 'tenantId', 'status', 'role']) &&
        request.resource.data.keys().hasOnly([
          'uid', 'tenantId', 'email', 'role', 'status', 'createdAt', 'updatedAt'
        ]) &&
        request.resource.data.uid is string &&
        request.resource.data.uid.size() > 0 &&
        request.resource.data.tenantId is string &&
        request.resource.data.tenantId.matches('^[a-z0-9][a-z0-9-]{1,62}[a-z0-9]$') &&
        request.resource.data.role in ['OWNER', 'ADMIN', 'MANAGER'] &&
        request.resource.data.status in ['ACTIVE', 'INACTIVE', 'SUSPENDED', 'EXPIRED', 'REVOKED'] &&
        isOptionalString('email');
    }

    function validTenantSubscription() {
      return request.resource.data.keys().hasOnly([
        'plan', 'status', 'trialEndsAt', 'currentPeriodStart', 'currentPeriodEnd',
        'createdAt', 'updatedAt'
      ]) &&
        isOptionalString('plan') &&
        (!('status' in request.resource.data) || request.resource.data.status in [
          'ACTIVE', 'TRIALING', 'PAST_DUE', 'CANCELLED', 'DISABLED'
        ]);
    }

    function validTenantTokenRequest() {
      return request.resource.data.keys().hasAll(['email', 'status']) &&
        request.resource.data.keys().hasOnly([
          'email', 'requesterName', 'note', 'status', 'createdAt', 'updatedAt'
        ]) &&
        request.resource.data.email is string &&
        request.resource.data.email.size() > 0 &&
        request.resource.data.email.size() <= 254 &&
        (!('requesterName' in request.resource.data) ||
          (request.resource.data.requesterName is string && request.resource.data.requesterName.size() <= 120)) &&
        (!('note' in request.resource.data) ||
          (request.resource.data.note is string && request.resource.data.note.size() <= 1000)) &&
        request.resource.data.status in ['PENDING', 'APPROVED', 'REJECTED', 'CANCELLED'];
    }

    match /employees/{employeeId} {
      allow read, write: if false;
    }

    match /employees_public/{employeeId} {
      allow read, write: if false;
    }

    match /employees_private/{employeeId} {
      allow read, write: if false;
    }

    match /shifts/{shiftId} {
      allow read, write: if false;
    }

    match /shiftTemplates/{templateId} {
      allow read, write: if false;
    }

    match /published_schedules/{resourceId} {
      allow read, write: if false;
    }

    match /monthly_schedule_exports/{exportId} {
      allow read: if isTenantAdmin(resource.data.tenantId);
      allow create, update: if isTenantAdmin(request.resource.data.tenantId) && validMonthlyScheduleExport(exportId);
      allow delete: if isTenantAdmin(resource.data.tenantId);
    }

    match /authTickets/{ticketId} {
      allow read, write: if false;
    }

    match /registrationTokens/{tokenId} {
      allow read, write: if false;
    }

    match /registrationTokenLookups/{lookupId} {
      allow read, write: if false;
    }

    match /platformAuditLogs/{logId} {
      allow read, write: if false;
    }

    match /rateLimits/{limitId} {
      allow read, write: if false;
    }

    match /employeeAbsences/{absenceId} {
      allow read, write: if false;
    }

    match /employeeAbsencesPublic/{absenceId} {
      allow read, write: if false;
    }

    match /employee_absences_private/{absenceId} {
      allow read, write: if false;
    }

    match /announcements/{announcementId} {
      allow read, write: if false;
    }

    match /attendance_history/{historyId} {
      allow read, write: if false;
    }

    match /week_locks/{weekId} {
      allow read, write: if false;
    }

    match /week_history/{historyId} {
      allow read, write: if false;
    }

    match /week_templates/{templateId} {
      allow read, write: if false;
    }

    match /scheduler_settings/{settingsId} {
      allow read, write: if false;
    }

    match /audit_logs/{auditLogId} {
      allow read, write: if false;
    }

    match /platformAdmins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /users/{uid} {
      allow read: if isAdmin() || isSelf(uid);
      allow create, update: if isAdmin() && validUserProfile(uid);
      allow delete: if isAdmin();
    }

    match /tenantMemberships/{membershipId} {
      allow read: if isSignedIn() &&
        (
          (
            resource.data.uid == request.auth.uid &&
            resource.data.status == 'ACTIVE' &&
            isTenantAdminRole(resource.data.role)
          ) ||
          (
            resource.data.tenantId is string &&
            isTenantAdmin(resource.data.tenantId)
          )
        );
      allow create, update, delete: if false;
    }

    match /tenants/{tenantId} {
      allow read: if isTenantAdmin(tenantId);
      allow create, update: if isAdmin() && validTenant();
      allow delete: if isAdmin();

      match /employees/{employeeId} {
        allow read: if isTenantAdmin(tenantId);
        allow create: if isTenantAdmin(tenantId) && validEmployee();
        allow update: if isTenantAdmin(tenantId) && onlyChanged(employeeFields()) && validEmployee();
        allow delete: if isTenantAdmin(tenantId);
      }

      match /publicEmployees/{employeeId} {
        allow read: if true;
        allow create, update: if isTenantAdmin(tenantId) && validTenantPublicEmployee(tenantId);
        allow delete: if isTenantAdmin(tenantId);
      }

      match /shifts/{shiftId} {
        allow read: if isTenantAdmin(tenantId);
        allow create: if isTenantAdmin(tenantId) && (validShift() || validDraftShiftV3());
        allow update: if isTenantAdmin(tenantId) && ((onlyChanged(shiftFields()) && validShift()) || (resource.data.schedulerSchemaVersion == 3 && validDraftShiftV3()));
        allow delete: if isTenantAdmin(tenantId);
      }

      match /shiftTemplates/{templateId} {
        allow read: if isTenantAdmin(tenantId);
        allow create, update: if isTenantAdmin(tenantId) && validTemplate();
        allow delete: if isTenantAdmin(tenantId);
      }

      match /absences/{absenceId} {
        allow read: if isTenantAdmin(tenantId);
        allow create: if isTenantAdmin(tenantId) && validAbsence();
        allow update: if isTenantAdmin(tenantId) && onlyChanged(absenceFields()) && validAbsence();
        allow delete: if isTenantAdmin(tenantId);
      }

      match /publicSchedules/{weekStart} {
        allow read: if true;
        allow create, update: if isTenantAdmin(tenantId) && validTenantPublicSchedule(tenantId, weekStart);
        allow delete: if isTenantAdmin(tenantId);
      }

      match /publicMonths/{yearMonth} {
        allow read: if true;
        allow create, update: if isTenantAdmin(tenantId) && validTenantPublicMonth(tenantId, yearMonth);
        allow delete: if isTenantAdmin(tenantId);
      }

      match /settings/{settingsId} {
        allow read: if isTenantAdmin(tenantId);
        allow create, update: if isTenantAdmin(tenantId) && validSchedulerSettings();
        allow delete: if isTenantAdmin(tenantId);
      }

      match /scheduleDrafts/{draftId} {
        allow read: if isTenantAdmin(tenantId);
        allow create, update: if isTenantAdmin(tenantId) && request.resource.data.tenantId == tenantId && request.resource.data.schemaVersion == 3 && request.resource.data.id == draftId && request.resource.data.config.tenantId == tenantId && request.resource.data.updatedBy == request.auth.uid;
        allow delete: if false;
      }
      match /schedulePublicationCounters/{periodKey} {
        allow read: if isTenantAdmin(tenantId);
        allow create: if isTenantAdmin(tenantId) && request.resource.data.keys().hasOnly(['tenantId','version','lastReservedId']) && request.resource.data.tenantId == tenantId && request.resource.data.lastReservedId is string && request.resource.data.version == 1;
        allow update: if isTenantAdmin(tenantId) && request.resource.data.keys().hasOnly(['tenantId','version','lastReservedId']) && request.resource.data.tenantId == tenantId && request.resource.data.lastReservedId is string && request.resource.data.version == resource.data.version + 1;
        allow delete: if false;
      }
      match /schedulePublicationReservations/{publicationId} {
        allow read: if isTenantAdmin(tenantId);
        allow create: if isTenantAdmin(tenantId) && request.resource.data.keys().hasOnly(['tenantId','periodKey','version','publishedByUid']) && request.resource.data.tenantId == tenantId && request.resource.data.publishedByUid == request.auth.uid && request.resource.data.version == getAfter(/databases/$(database)/documents/tenants/$(tenantId)/schedulePublicationCounters/$(request.resource.data.periodKey)).data.version && publicationId == getAfter(/databases/$(database)/documents/tenants/$(tenantId)/schedulePublicationCounters/$(request.resource.data.periodKey)).data.lastReservedId;
        allow update, delete: if false;
      }
      match /schedulePublications/{publicationId} {
        allow read: if isTenantAdmin(tenantId);
        allow create: if isTenantAdmin(tenantId) && request.resource.data.keys().hasOnly(['id','tenantId','schemaVersion','periodType','periodStart','periodEnd','periodKey','version','sourceDraftId','sourcePublicationId','templateSnapshot','employeeSnapshot','shifts','calculatedHours','warningsAtPublish','publishedWithWarnings','pdfStoragePath','pdfGeneratedAt','publishedAt','publishedByUid']) &&
          request.resource.data.id == publicationId && request.resource.data.tenantId == tenantId && request.resource.data.schemaVersion == 3 && request.resource.data.templateSnapshot.tenantId == tenantId && request.resource.data.publishedByUid == request.auth.uid && request.resource.data.periodType in ['WEEK','MONTH'] &&
          request.resource.data.pdfStoragePath == 'tenants/' + tenantId + '/schedule-publications/' + publicationId + '/schedule.pdf' &&
          request.resource.data.version == get(/databases/$(database)/documents/tenants/$(tenantId)/schedulePublicationReservations/$(publicationId)).data.version &&
          request.resource.data.periodKey == get(/databases/$(database)/documents/tenants/$(tenantId)/schedulePublicationReservations/$(publicationId)).data.periodKey;
        allow update, delete: if false;
      }
      match /schedulePublicationPeriods/{periodKey} {
        allow read: if isTenantAdmin(tenantId);
        allow create, update: if isTenantAdmin(tenantId) && request.resource.data.keys().hasOnly(['tenantId','periodKey','latestVersion','latestPublicationId','updatedAt']) && request.resource.data.tenantId == tenantId && request.resource.data.periodKey == periodKey &&
          request.resource.data.latestVersion == getAfter(/databases/$(database)/documents/tenants/$(tenantId)/schedulePublications/$(request.resource.data.latestPublicationId)).data.version &&
          periodKey == getAfter(/databases/$(database)/documents/tenants/$(tenantId)/schedulePublications/$(request.resource.data.latestPublicationId)).data.periodKey;
        allow delete: if false;
      }

      match /announcements/{announcementId} {
        allow read: if isTenantAdmin(tenantId);
        allow create, update: if isTenantAdmin(tenantId) && validAnnouncement();
        allow delete: if isTenantAdmin(tenantId);
      }

      match /attendanceHistory/{historyId} {
        allow read: if isTenantAdmin(tenantId);
        allow create, update: if isTenantAdmin(tenantId) && validAttendanceHistory();
        allow delete: if isTenantAdmin(tenantId);
      }

      match /weekLocks/{weekId} {
        allow read: if isTenantAdmin(tenantId);
        allow create, update: if isTenantAdmin(tenantId) && validWeekLock();
        allow delete: if isTenantAdmin(tenantId);
      }

      match /weekHistory/{historyId} {
        allow read: if isTenantAdmin(tenantId);
        allow create, update: if isTenantAdmin(tenantId) && validWeekHistory();
        allow delete: if isTenantAdmin(tenantId);
      }

      match /weekTemplates/{templateId} {
        allow read: if isTenantAdmin(tenantId);
        allow create, update: if isTenantAdmin(tenantId) && validTemplate();
        allow delete: if isTenantAdmin(tenantId);
      }

      match /subscription/{subscriptionId} {
        allow read: if isTenantAdmin(tenantId);
        allow create, update: if isTenantAdmin(tenantId) && validTenantSubscription();
        allow delete: if isTenantAdmin(tenantId);
      }

      match /tokenRequests/{requestId} {
        allow read: if isTenantAdmin(tenantId);
        allow create, update: if isTenantAdmin(tenantId) && validTenantTokenRequest();
        allow delete: if isTenantAdmin(tenantId);
      }

      match /auditLogs/{auditLogId} {
        allow read: if isTenantAdmin(tenantId);
        allow create: if isTenantAdmin(tenantId) && validAuditLog();
        allow update, delete: if false;
      }

      match /publicAnnouncements/{announcementId} {
        allow read: if true;
        allow create, update: if isTenantAdmin(tenantId) && validTenantPublicAnnouncement(tenantId);
        allow delete: if isTenantAdmin(tenantId);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
